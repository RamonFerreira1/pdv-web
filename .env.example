# =============================================
# Variáveis de ambiente — Frontend
# Copie este arquivo como .env.local para desenvolvimento
# Para Render: configure no painel Environment Variables
# =============================================

# URL do backend (só necessário quando o frontend NÃO estiver no mesmo container/domínio)
# Docker local: deixe em branco (Nginx faz o proxy automaticamente)
# Render online: coloque a URL do seu backend, ex: https://pdv-backend.onrender.com
VITE_API_URL=
